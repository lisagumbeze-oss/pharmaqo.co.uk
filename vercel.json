{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "storefront": {
      "root": "apps/storefront/",
      "framework": "nextjs"
    },
    "cms": {
      "root": "apps/cms/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "storefront" }
    }
  ]
}
